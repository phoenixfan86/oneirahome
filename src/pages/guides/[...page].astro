---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import { buildListSchema } from '../../lib/schema';

export const getStaticPaths = (async ({ paginate }) => {
  const allGuides = await getCollection(
    'guides',
    ({ data }: CollectionEntry<'guides'>) => !data.draft
  );

  const sorted = allGuides.sort(
    (a: CollectionEntry<'guides'>, b: CollectionEntry<'guides'>) =>
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return paginate(sorted, { pageSize: 7 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<'guides'>>;
}

const { page } = Astro.props;
const guideCount = page.total;
const pageTitle = page.currentPage === 1 ? 'Lucid Dreaming, Sleep Paralysis & Science Guides | Oneira Home' : `Lucid Dreaming & Sleep Guides — Page ${page.currentPage} | Oneira Home`;
const pageDescription = `${guideCount} in-depth guide${guideCount === 1 ? '' : 's'} on lucid dreaming, sleep paralysis, recurring dreams, and the science of sleep — practical techniques and explanations that go beyond individual dream symbol meanings.`;

const listSchema = buildListSchema({
  name: pageTitle,
  description: pageDescription,
  url: Astro.url.href,
  site: Astro.site,
  entries: page.data,
  basePath: '/guides/',
});
---
<BaseLayout title={pageTitle} description={pageDescription} schema={listSchema}>
  <h1>Lucid Dreaming & Sleep Guides</h1>
  <p>In-depth guides on lucid dreaming, sleep paralysis, and the science behind why we dream — practical techniques, not just symbol lookups.</p>

  <div class="moon-divider">☾</div>

  <ul class="dream-list">
    {page.data.map((entry) => (
      <li class="dream-item">
        <a href={`/guides/${entry.slug}/`}>
        {entry.data.img && (
          <div class="dream-img">
            <img
              src={entry.data.img}
              alt={entry.data.title}
              width="480"
              height="255"
              loading="lazy"
            />
          </div>
        )}
          <h2>{entry.data.title}</h2>
        </a>
        <p class="dream-excerpt">{entry.data.description}</p>
      </li>
    ))}
  </ul>

  <nav class="pagination">
    {page.url.prev ? <a href={page.url.prev}>← Previous</a> : <span />}
    <span>Page {page.currentPage} of {page.lastPage}</span>
    {page.url.next ? <a href={page.url.next}>Next →</a> : <span />}
  </nav>
</BaseLayout>

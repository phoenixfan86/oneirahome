
<button id="quick-journal-btn" class="quick-journal-fab" type="button" aria-haspopup="dialog">
  🌙 Log a Dream
</button>

<div id="quick-journal-modal" class="quick-journal-overlay" hidden>
  <div class="quick-journal-dialog" role="dialog" aria-modal="true" aria-label="Log a dream">
    <button id="quick-journal-close" class="quick-journal-close" type="button" aria-label="Close">✕</button>

    <h2>Log tonight's dream</h2>

    <label for="qj-text">What did you dream about?</label>
    <textarea id="qj-text" rows="4" placeholder="Write down what you remember..."></textarea>

    <p class="qj-mood-label">How did it feel?</p>
    <div class="qj-mood-scale" role="radiogroup" aria-label="Dream mood">
      <button type="button" class="qj-mood-option" data-mood="1" aria-label="Nightmare">😣</button>
      <button type="button" class="qj-mood-option" data-mood="2" aria-label="Unpleasant">😟</button>
      <button type="button" class="qj-mood-option" data-mood="3" aria-label="Neutral">😐</button>
      <button type="button" class="qj-mood-option" data-mood="4" aria-label="Pleasant">🙂</button>
      <button type="button" class="qj-mood-option" data-mood="5" aria-label="Great">😊</button>
    </div>

    <button id="qj-save" class="qj-save-btn" type="button">Save entry</button>
    <p id="qj-confirmation" class="qj-confirmation" hidden>
      Saved! <a href="/journal/">View your journal →</a>
    </p>
  </div>
</div>

<script>
  const STORAGE_KEY = 'oneirahome-dream-journal';

  const openBtn = document.getElementById('quick-journal-btn');
  const closeBtn = document.getElementById('quick-journal-close');
  const overlay = document.getElementById('quick-journal-modal');
  const textEl = document.getElementById('qj-text') as HTMLTextAreaElement | null;
  const saveBtn = document.getElementById('qj-save');
  const confirmation = document.getElementById('qj-confirmation');
  const moodButtons = document.querySelectorAll<HTMLButtonElement>('.qj-mood-option');

  let selectedMood: number | null = null;

  function openModal() {
    overlay?.removeAttribute('hidden');
  }
  function closeModal() {
    overlay?.setAttribute('hidden', '');
    if (textEl) textEl.value = '';
    selectedMood = null;
    moodButtons.forEach((b) => b.classList.remove('selected'));
    confirmation?.setAttribute('hidden', '');
  }

  openBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeModal();
  });

  moodButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      selectedMood = Number(btn.dataset.mood);
      moodButtons.forEach((b) => b.classList.remove('selected'));
      btn.classList.add('selected');
    });
  });

  saveBtn?.addEventListener('click', () => {
    const text = textEl?.value.trim();
    if (!text) return;

    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      const entries = raw ? JSON.parse(raw) : [];
      entries.push({
        id: crypto.randomUUID(),
        text,
        tags: [],
        mood: selectedMood,
        createdAt: new Date().toISOString(),
      });
      localStorage.setItem(STORAGE_KEY, JSON.stringify(entries));
      if (textEl) textEl.value = '';
      confirmation?.removeAttribute('hidden');
    } catch {
      // localStorage unavailable (private browsing, etc.) — fail quietly
    }
  });
</script>


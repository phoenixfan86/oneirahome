---
import Analytics from '@vercel/analytics/astro'
import Sidebar from '../components/Sidebar.astro';
import Tagbadge from '../components/TagBadge.astro';
import StarField from '../components/StarField.astro';
import '../styles/global.css';
import { getDreamCount } from '../lib/dreamCount';

interface Props {
  title: string;
  description: string;
  currentSlug?: string;
  image?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, image, currentSlug, schema } = Astro.props;
const ogImageUrl = new URL(image ?? '/img/moon.webp', Astro.site).href;

const schemaList = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Oneira Home',
  url: Astro.site?.href ?? Astro.url.origin,
  description: 'A dictionary of dream meanings and interpretations.',
  sameAs: [
    'https://x.com/Oneirahome',
    'https://www.tumblr.com/oneirahome',
    'https://www.quora.com/profile/OneiraHome',
    'https://agocurrus506797.substack.com',
    'https://www.pinterest.com/oneirahome',
  ],
};

const totalDreams = await getDreamCount();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={Astro.url} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="alternate" type="application/rss+xml" title="Oneirahome - Dreams Dictionary" href="/rss.xml" />
    <link rel="me" href="https://mastodon.social/@oneirahome">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
    <!-- <link href="/pagefind/pagefind-ui.css" rel="stylesheet" /> -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Oneira Home" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={ogImageUrl}>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="blogarama-site-verification" content="blogarama-6b0069dd-2ca7-4639-bc51-64f418ea7de9">
    <meta name="p:domain_verify" content="fd640d88647c4424e66c2394a4fce868"/>

    <script src="https://analytics.ahrefs.com/analytics.js" data-key="f7IrqYJ95PfVavfoyJRmsg" async></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {schemaList.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    
<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-BVS1JC86NV"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-BVS1JC86NV');
</script>

    <Analytics />
  </head>
  <>
  <StarField />
    <header class="site-header">
      
      <div class="container">
        <div class="">
          <a href="/" class="site-title">
            <span class="moon">🌙</span> 
            <div class="logo"><span class="text">Oneira</span><span class="home">Home</span>
            </div>
          </a>
          <p class="site-tagline">Understand what your dreams are telling you</p>
        </div>
<nav>
  <ul class="main-nav">
    <li><a href="/">Dreams</a></li>
    <li><a href="/guides/">Guides</a></li>
    <li><a href="/journal/">Dream Journal</a></li>
    <li><a href="/articles/">Top 5 Roundups</a></li>
  </ul>
</nav>
        <div class="search">
          <span>Find your dream</span>
          <div id="search"></div>
        </div>
      </div>
      <script is:inline>
  function loadPagefind() {
    const cssLink = document.createElement('link');
    cssLink.rel = 'stylesheet';
    cssLink.href = '/pagefind/pagefind-ui.css';
    document.head.appendChild(cssLink);

    const script = document.createElement('script');
    script.src = '/pagefind/pagefind-ui.js';
    script.onload = () => {
      if (typeof PagefindUI !== 'undefined') {
        new PagefindUI({ element: '#search', showSubResults: true, showImages: false });
      }
    };
    document.body.appendChild(script);
  }

  if (document.readyState === 'complete') {
    loadPagefind();
  } else {
    window.addEventListener('load', loadPagefind);
  }
</script>
       
<!-- <script src="/pagefind/pagefind-ui.js" is:inline></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    if (typeof PagefindUI !== 'undefined') {
      new PagefindUI({ element: '#search', showSubResults: true, showImages: false });
    }
  });
</script> -->
    </header>
     <Tagbadge/>  
      <main data-pagefind-body>
        
        <div class="container">
          
          <slot />
        </div>
      <Sidebar currentSlug={currentSlug}/>
      <div class="top-btn">
        <a href="#" aria-label="Back to top"></a>
      </div>
      </main>

    <footer class="site-footer">
      <nav>
        <ul class="f-nav">
          <li><a href="/about/">About us</a></li>
          <li><a href="/cookie-policy/">Cookie policy</a></li>
          <li><a href="/terms/">Terms</a></li>
          <li><a href="/privacy-policy/">Privacy policy</a></li>
          <li><a href="https://www.trustpilot.com/review/oneirahome.com" target="_blank" rel="noopener">
              Review us on Trustpilot
            </a></li>
        </ul>
      </nav>
      <div class="container">
        <p>© {new Date().getFullYear()} Oneira Home. Interpretations are for reflection, not medical or psychological advice.</p>
        <span>{totalDreams} dream meanings and counting</span>
      </div>
      
    </footer>
  </body>
</html>

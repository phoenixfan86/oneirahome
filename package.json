{
  "name": "Oneirahome",
  "type": "module",
  "version": "0.4.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "generate": "node --env-file=.env scripts/generate-dreams.mjs",
    "generate-guide": "node --env-file=.env scripts/generate-guides.mjs",
    "edit": "node --env-file=.env scripts/edit-dreams.mjs",
    "fill-tags": "node --env-file=.env scripts/fill-tags.mjs",
    "fill-faq": "node --env-file=.env scripts/fill-faq.mjs",
    "fill-faq-guides": "node --env-file=.env scripts/fill-faq-guides.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.9",
    "@astrojs/sitemap": "3.6.0",
    "@vercel/analytics": "^2.0.1",
    "astro": "^4.15.0"
  },
  "devDependencies": {
    "pagefind": "^1.1.0",
    "sharp": "^0.35.4"
  }
}

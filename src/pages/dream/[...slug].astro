---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { getReadingTime } from '../../lib/readingTime';
import RelatedDreams from '../../components/RelatedDreams.astro';

export const getStaticPaths = (async () => {
  const dreams = await getCollection(
    'dreams',
    ({ data }: CollectionEntry<'dreams'>) => !data.draft
  );
  return dreams.map((entry: CollectionEntry<'dreams'>) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<'dreams'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const readingTime = getReadingTime(entry.body);
---
<BaseLayout title={entry.data.title} description={entry.data.description} image={entry.data.img}>
  <article class="dream-body">
    <span class="read-time">{readingTime}</span>
    
    <h1 class="dream-title">{entry.data.title}</h1>
    <p class="dream-meta">
      Category: <a href={`/categories/${entry.data.category}`}>{entry.data.category}</a>
      {entry.data.tags.length > 0 && (
        <>
          {' · '}
          {entry.data.tags.map((tag: string, i: number) => (
            <>
              <a href={`/tags/${tag}/`}>{tag}</a>{i < entry.data.tags.length - 1 ? ', ' : ''}
            </>
          ))}
        </>
      )}
    </p>
    {entry.data.img && (
      <div class="dream-img">
        <img
        src={entry.data.img}
        alt={entry.data.title}
        width="640"
        />
      </div>
    )}
    <Content />
    <RelatedDreams category={entry.data.category} excludeSlug={entry.slug} />
  </article>
</BaseLayout>

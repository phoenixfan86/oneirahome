---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import { buildListSchema } from '../../../lib/schema';

export const getStaticPaths = (async ({ paginate }) => {
  const allDreams = await getCollection(
    'dreams',
    ({ data }: CollectionEntry<'dreams'>) => !data.draft
  );

  const allCategories = [...new Set(allDreams.map((entry: CollectionEntry<'dreams'>) => entry.data.category))];

  return allCategories.flatMap((category: string) => {
    const filtered = allDreams
      .filter((entry: CollectionEntry<'dreams'>) => entry.data.category === category)
      .sort(
        (a: CollectionEntry<'dreams'>, b: CollectionEntry<'dreams'>) =>
          b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
      );

    return paginate(filtered, {
      params: { category },
      pageSize: 20,
    });
  });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<'dreams'>>;
}

function capitalize(s: string) {
  return s.charAt(0).toUpperCase() + s.slice(1);
}

const { category } = Astro.params;
const { page } = Astro.props;
const totalCount = page.total;

const pageTitle =
  page.currentPage === 1
    ? `${capitalize(category)} Dream Meanings | Oneira Home`
    : `${capitalize(category)} Dream Meanings - Page ${page.currentPage} | Oneira Home`;

const pageDescription = `Explore ${totalCount} dream ${totalCount === 1 ? 'meaning' : 'meanings'} in the ${category} category - what these dreams tend to symbolize and what they might reflect about your waking life.`;

const listSchema = buildListSchema({
  name: pageTitle,
  description: pageDescription,
  url: Astro.url.href,
  site: Astro.site,
  entries: page.data,
});
---
<BaseLayout title={pageTitle} description={pageDescription} schema={listSchema}>
  <h1>Category: {category}</h1>

  <ul class="dream-list">
    {page.data.map((entry) => (
      <li>
        <a href={`/dream/${entry.slug}/`}>
        {entry.data.img && (
          <div class="dream-img">
            <img
              src={entry.data.img}
              alt={entry.data.title}
              width="480"
              height="255"
              loading="lazy"
            />
          </div>
        )}
        <h2>{entry.data.title}</h2>
        </a>
        <p class="dream-excerpt">{entry.data.description}</p>
      </li>
    ))}
  </ul>

  <nav class="pagination">
    {page.url.prev ? <a href={page.url.prev}>← Previous</a> : <span />}
    <span>Page {page.currentPage} of {page.lastPage}</span>
    {page.url.next ? <a href={page.url.next}>Next →</a> : <span />}
  </nav>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import { buildListSchema } from '../lib/schema';
import { getThumbPath } from '../lib/thumb';

export const getStaticPaths = (async ({ paginate }) => {
  const allDreams = await getCollection(
    'dreams',
    ({ data }: CollectionEntry<'dreams'>) => !data.draft
  );

  const sorted = allDreams.sort(
    (a: CollectionEntry<'dreams'>, b: CollectionEntry<'dreams'>) =>
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return paginate(sorted, { pageSize: 7 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<'dreams'>>;
}

const { page } = Astro.props;
const isFirstPage = page.currentPage === 1;

function getPageNumbers(current: number, last: number): (number | 'ellipsis')[] {
  const range = new Set<number>([1, last, current, current - 1, current + 1]);
  const sorted = [...range].filter((n) => n >= 1 && n <= last).sort((a, b) => a - b);

  const result: (number | 'ellipsis')[] = [];
  let prev = 0;
  for (const n of sorted) {
    if (n - prev > 1) result.push('ellipsis');
    result.push(n);
    prev = n;
  }
  return result;
}

const sampleSymbols = page.data
  .slice(0, 3)
  .map((entry) => entry.data.symbol)
  .join(', ');

const pageNumbers = getPageNumbers(page.currentPage, page.lastPage);

const pageTitle = isFirstPage
  ? 'Oneira Home - Dream Dictionary & Meanings'
  : `Oneira Home - Dream Dictionary & Meanings: Page ${page.currentPage}`;

const pageDescription = isFirstPage
  ? 'Explore Oneira Home, a growing dictionary of dream meanings and interpretations. Understand common symbols like snakes and teeth or complex dream scenarios.'
  : `Page ${page.currentPage} of ${page.lastPage} of the Oneira Home dream dictionary, including meanings for ${sampleSymbols} and more.`;

const listSchema = buildListSchema({
  name: pageTitle,
  description: pageDescription,
  url: Astro.url.href,
  site: Astro.site,
  entries: page.data,
});
---
<BaseLayout title={pageTitle} description={pageDescription} schema={listSchema}>
  {isFirstPage && (
    <>
      <h1>Dream Dictionary</h1>
      <p> Explore dream meanings and look up what your dream might mean.
  Every entry below has been reviewed before publishing.</p>
      <div class="moon-divider">☾</div>
    </>
  )}

  {!isFirstPage && <h1>Dream Dictionary - Page {page.currentPage}</h1>}
  
  <h2>Explore Dream Meanings</h2>
  <ul class="dream-list">
    {page.data.map((entry) => (
      <li class="dream-item">
        <a href={`/dream/${entry.slug}/`}>
        {entry.data.img && (
          <div class="dream-img">
            <img
              src={getThumbPath(entry.data.img)}
              alt={entry.data.title}
              width="480"
              height="255"
              loading="lazy"
            />
          </div>
        )}
          <h2>{entry.data.title}</h2>
        </a>
        <p class="dream-excerpt">{entry.data.description}</p>
        <p><span>Category: </span>{entry.data.category}</p>
        <div class="read-more">
          <a href={`/dream/${entry.slug}/`} class="read-more-link">
          Read more about {entry.data.symbol} →
                </a>
        </div>
      </li>
    ))}
  </ul>

  <nav class="pagination" aria-label="Pagination">
    {page.url.prev ? <a href={page.url.prev}>← Previous</a> : <span />}

    <div class="page-numbers">
      {pageNumbers.map((n) =>
        n === 'ellipsis' ? (
          <span class="ellipsis">…</span>
        ) : (
          <a
            href={n === 1 ? '/' : `/${n}/`}
            class={n === page.currentPage ? 'current' : ''}
            aria-current={n === page.currentPage ? 'page' : undefined}
          >
            {n}
          </a>
        )
      )}
    </div>

    {page.url.next ? <a href={page.url.next}>Next →</a> : <span />}
  </nav>

  {isFirstPage && (
    <>
      <div class="moon-divider">☾</div>
      <div>
        <h2>Most commonly read dream interpretations</h2>
        <ul class="top-items">
          <li><a href="/dream/dream/giving-birth/">Dreaming About Giving Birth</a></li>
          <li><a href="/dream/dream/turtle/">Dreaming About Turtle</a></li>
          <li><a href="/dream/dream/broken-glass/">Dreaming About Broken Glass</a></li>
          <li><a href="/dream/dream/bees/">Dreaming About Bees</a></li>
          <li><a href="/dream/dream/rain/">Dreaming About Rain</a></li>
        </ul>
      </div>
      <div class="moon-divider">☾</div>
      <p>
        <a href="/tags/">Browse by tag →</a><br />
        <a href="/guides/">Sleep & Dream Guides →</a><br />
        <a href="/journal/">Start your free Dream Journal →</a>
      </p>

      <section class="seo-intro">
        <h2>Why Use a Dream Dictionary?</h2>
        <p>A dream dictionary can help you explore common symbols, recurring themes, and possible interpretations. Dream meanings are personal, so use these interpretations as starting points for reflection rather than fixed answers.</p>
        <h2>Welcome to Oneira Home</h2>
        <p>
          Oneira Home is a free dream meaning search and dictionary built to help you understand
          what your dreams might mean. The name comes from "oneira," the ancient Greek
          word for dreams - and that's exactly what this site is about: clear,
          thoughtful interpretations for the symbols, people, and scenarios that show
          up in sleep.
        </p>
        <p>
          Every entry looks at a dream symbol from a few angles - its general meaning,
          the most common ways it tends to appear, a psychological perspective, and a
          short prompt to help you reflect on what it might mean for your own life.
          We don't treat dream interpretation as fixed fact; think of it as a starting
          point for thinking through what your mind might be processing.
        </p>
        <p>
          New meanings are added regularly. Explore the dictionary above, or browse by
          <a href="/tags/">tag</a> to find dreams grouped by theme, from fear and
          transformation to relationships and change.
        </p>
      </section>
    </>
  )}
</BaseLayout>

---
import Analytics from '@vercel/analytics/astro'
import Sidebar from '../components/Sidebar.astro';
import Tagbadge from '../components/TagBadge.astro';
import StarField from '../components/StarField.astro';
import QuickJournalButton from '../components/QuickJournalButton.astro';
import  TableOfContents  from '../components/TableOfContents.astro';
import '../styles/global.css';
import { getDreamCount } from '../lib/dreamCount';

interface Props {
  robots?: string;
  title: string;
  description: string;
  currentSlug?: string;
  image?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  tocItems?: { depth: number; slug: string; text: string }[];
}
const canonicalURL = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ''), Astro.site || 'https://oneirahome.com');
const { robots = 'index, follow', title, description, image, currentSlug, schema, tocItems = [] } = Astro.props;
const ogImageUrl = new URL(image ?? '/img/moon.webp', Astro.site).href;

const schemaList = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Oneira Home',
  url: Astro.site?.href ?? Astro.url.origin,
  description: 'A dictionary of dream meanings and interpretations.',
  sameAs: [
    'https://x.com/Oneirahome',
    'https://www.tumblr.com/oneirahome',
    'https://www.quora.com/profile/OneiraHome',
    'https://agocurrus506797.substack.com',
    'https://www.pinterest.com/oneirahome',
  ],
};
const siteHome = new URL('/', Astro.site).href;
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteHome}#organization`,
  name: 'Oneira Home',
  url: siteHome,
  logo: `${siteHome}img/moon.png`,
  sameAs: [
    'https://x.com/Oneirahome',
    'https://www.tumblr.com/oneirahome',
    'https://www.quora.com/profile/OneiraHome',
    'https://agocurrus506797.substack.com',
    'https://www.pinterest.com/oneirahome',
  ],
};

const totalDreams = await getDreamCount();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content="Oneira Home" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="alternate" type="application/rss+xml" title="Oneirahome - Dreams Dictionary" href="/rss.xml" />
    <link rel="me" href="https://mastodon.social/@oneirahome">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Oneira Home" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={ogImageUrl}>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content="#171d4e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffe182" media="(prefers-color-scheme: light)" />
    <meta name="blogarama-site-verification" content="blogarama-6b0069dd-2ca7-4639-bc51-64f418ea7de9">
    <meta name="p:domain_verify" content="fd640d88647c4424e66c2394a4fce868"/>

    <script src="https://analytics.ahrefs.com/analytics.js" data-key="f7IrqYJ95PfVavfoyJRmsg" async></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {schemaList.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    
<!-- Google tag (gtag.js) -->
 <script is:inline>

  if (localStorage.getItem('oneira_no_analytics') === '1') {
    window['ga-disable-G-BVS1JC86NV'] = true;
  }
</script>
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-BVS1JC86NV"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-BVS1JC86NV'); 

  (function() {
    const thresholds =[25, 50, 75, 100];
    const firedThresholds = {};

    window.addEventListener('scroll', function() {
      
      const scrollTop = window.scrollY || window.pageYOffset || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
 
      if (docHeight <= 0) return;

      const scrollPercent = Math.round((scrollTop / docHeight) * 100);

      thresholds.forEach(threshold => {
        if (scrollPercent >= threshold && !firedThresholds[threshold]) {
          firedThresholds[threshold] = true; // Мітимо як надіслану

          gtag('event', 'custom_scroll', {
            'scroll_depth': threshold
          });
        }
      });
    });
  })();
</script>


    <Analytics />
  </head>
  <>
  <StarField />
  
    <header class="site-header">
      
      <div class="container">
        <div class="logo-wrapper">
          <a href="/" class="site-title">
            <span class="moon">🌙</span> 
            <div class="logo"><span class="text">Oneira</span><span class="home">Home</span>
            </div>
          </a>
          <p class="site-tagline">Understand what your dreams are telling you</p>
        </div>
        <nav>
          <ul class="main-nav">
            <li><a href="/">Dreams</a></li>
            <li><a href="/guides/">Guides</a></li>
            <li><a href="/journal/">Dream Journal</a></li>
            <li><a href="/articles/">Top 5 Roundups</a></li>
          </ul>
        </nav>
        <div class="search">
          <span>Find your dream</span>
          <div id="search"></div>
        </div>
      </div>
      <script is:inline>
        function loadPagefind() {
          const cssLink = document.createElement('link');
          cssLink.rel = 'stylesheet';
          cssLink.href = '/pagefind/pagefind-ui.css';
          document.head.appendChild(cssLink);

          const script = document.createElement('script');
          script.src = '/pagefind/pagefind-ui.js';
          script.onload = () => {
            if (typeof PagefindUI !== 'undefined') {
              new PagefindUI({ element: '#search', showSubResults: true, showImages: false });
            }
          };
          document.body.appendChild(script);
        }

        if (document.readyState === 'complete') {
          loadPagefind();
        } else {
          window.addEventListener('load', loadPagefind);
        }
      </script>
    </header>
     <Tagbadge/> 
     
      <main data-pagefind-body class="main">
        <aside class="toc-column">
    {tocItems.length > 2 && <TableOfContents items={tocItems} />}
  </aside>
        <div class="container">
          
          <slot />
        </div>
      <Sidebar currentSlug={currentSlug}/>
      <div class="top-btn">
        <a href="#" aria-label="Back to top"></a>
      </div>
      </main>

    <footer class="site-footer">
      <nav>
        <ul class="f-nav">
          <li><a href="/about/">About us</a></li>
          <li><a href="/cookie-policy/">Cookie policy</a></li>
          <li><a href="/terms/">Terms</a></li>
          <li><a href="/privacy-policy/">Privacy policy</a></li>
          <li><a href="https://www.trustpilot.com/review/oneirahome.com" target="_blank" rel="noopener">
              Review us on Trustpilot
            </a></li>
        </ul>
      </nav>
      <div class="">
        <ul class="other-icons">
          <li>
            <a href="https://startupfa.me/s/oneirahome?utm_source=oneirahome.com" target="_blank"><img src="https://startupfa.me/badges/featured-badge-small.webp" alt="OneiraHome - Featured on Startup Fame" width="224" height="36" /></a>
          </li>
          <li> 
            <a href="http://www.blogarama.com/fashion-blogs/1351624-blog/" title="Blogarama.com - Follow me on Blogarama" rel="nofollow">Blogarama - Blog Directory</a>
          </li>
        </ul>
      </div>
      <div class="container">
        <p>© {new Date().getFullYear()} Oneira Home. Interpretations are for reflection, not medical or psychological advice.</p>
        <span>{totalDreams} dream meanings and counting</span>
      </div>
      
    </footer>
     <QuickJournalButton />
  </body>
</html>

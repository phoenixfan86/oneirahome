---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import { buildListSchema } from '../../../lib/schema';

export const getStaticPaths = (async ({ paginate }) => {
  const allDreams = await getCollection(
    'dreams',
    ({ data }: CollectionEntry<'dreams'>) => !data.draft
  );

  const allTags = [...new Set(allDreams.flatMap((entry: CollectionEntry<'dreams'>) => entry.data.tags))];

  return allTags.flatMap((tag: string) => {
    const filtered = allDreams
      .filter((entry: CollectionEntry<'dreams'>) => entry.data.tags.includes(tag))
      .sort(
        (a: CollectionEntry<'dreams'>, b: CollectionEntry<'dreams'>) =>
          b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
      );

    return paginate(filtered, {
      params: { tag },
      pageSize: 20,
    });
  });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<'dreams'>>;
}

const { tag } = Astro.params;
const { page } = Astro.props;
const totalCount = page.total;

const pageTitle =
  page.currentPage === 1
    ? `Dreams About ${capitalize(tag)} - Meanings & Interpretations | Oneira Home`
    : `Dreams About ${capitalize(tag)} - Page ${page.currentPage} | Oneira Home`;

const pageDescription = `${totalCount} dream ${totalCount === 1 ? 'meaning' : 'meanings'} connected to ${tag} - browse interpretations that share this theme, from common symbols to specific scenarios.`;

function capitalize(s: string) {
  return s.charAt(0).toUpperCase() + s.slice(1);
}

const listSchema = buildListSchema({
  name: pageTitle,
  description: pageDescription,
  url: Astro.url.href,
  site: Astro.site,
  entries: page.data,
});
---
<BaseLayout title={pageTitle} description={`All dream meanings tagged "${tag}".`}>
  <h1>Dreams tagged: {tag}</h1>

  <ul class="dream-list">
    {page.data.map((entry) => (
      <li class="dream-item">
        <a href={`/dream/${entry.slug}/`}>
        {entry.data.img && (
          <div class="dream-img">
            <img
              src={entry.data.img}
              alt={entry.data.title}
              width="480"
              height="255"
              loading="lazy"
            />
          </div>
        )}
        <h2>{entry.data.title}</h2>
        </a>
        <p class="dream-excerpt">{entry.data.description}</p>
      </li>
    ))}
  </ul>

  <nav class="pagination">
    {page.url.prev ? <a href={page.url.prev}>← Previous</a> : <span />}
    <span>Page {page.currentPage} of {page.lastPage}</span>
    {page.url.next ? <a href={page.url.next}>Next →</a> : <span />}
  </nav>

  <p><a href="/tags/">← All tags</a></p>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const allDreams = await getCollection(
  'dreams',
  ({ data }: CollectionEntry<'dreams'>) => !data.draft
);

const allTags = Array.from(
  new Set(allDreams.flatMap((entry: CollectionEntry<'dreams'>) => entry.data.tags))
).sort((a: string, b: string) => a.localeCompare(b));
---
<BaseLayout title="All Dream Tags" description="Browse dream meanings by theme and symbol tag.">
  <h1>All Tags</h1>
  <p>Browse dream meanings grouped by theme.</p>

  <ul class="tag-grid">
    {allTags.map((tag: string) => (
      <li>
        <a href={`/tags/${tag}/`}>{tag}</a>
      </li>
    ))}
  </ul>
</BaseLayout>

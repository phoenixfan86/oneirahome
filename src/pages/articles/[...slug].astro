---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const roundups = await getCollection('roundups');
  return roundups.map((entry: CollectionEntry<'roundups'>) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<'roundups'>;
}

const { entry } = Astro.props;

// Look up each referenced dream article by its slug. If an article ever
// gets removed/renamed, getEntry returns undefined - filtered out below
// so a broken reference can't crash the build.
const dreamEntries = await Promise.all(
  entry.data.dreamSlugs.map((slug: string) => getEntry('dreams', slug))
);
const validDreams = dreamEntries.filter(
  (d): d is NonNullable<typeof d> => d !== undefined
);

const canonicalUrl = new URL(`/articles/${entry.id}/`, Astro.site).href;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.pubDate.toISOString(),
  author: { '@type': 'Organization', name: 'Dream Dictionary' },
  publisher: { '@type': 'Organization', name: 'Dream Dictionary' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Articles', item: new URL('/articles/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: canonicalUrl },
  ],
};
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  schema={[articleSchema, breadcrumbSchema]}
>
  <article>
    <h1>{entry.data.title}</h1>
    <ShareButtons url={canonicalUrl} title={entry.data.title} />
    <p class="dream-meta">{entry.data.period} · {entry.data.category}</p>

    <ol class="dream-list roundup-list">
      {validDreams.map((dream) => (
        <li class="dream-item">
          <a href={`/dream/${dream.slug}/`}>
            <h2>{dream.data.title}</h2>
          </a>
          <p class="dream-excerpt">{dream.data.description}</p>
          <a href={`/dream/${dream.slug}/`} class="read-more">Read the full meaning →</a>
        </li>
      ))}
    </ol>

    <div class="moon-divider">☾</div>
    <p><a href={`/categories/${entry.data.category}/`}>See all {entry.data.category} dream meanings →</a></p>
  </article>
</BaseLayout>


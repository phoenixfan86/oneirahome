---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import { buildListSchema } from '../../../lib/schema';
import { getThumbPath } from '../../../lib/thumb';

export const getStaticPaths = (async ({ paginate }) => {
  const allDreams = await getCollection(
    'dreams',
    ({ data }: CollectionEntry<'dreams'>) => !data.draft
  );

  const allCategories = [...new Set(allDreams.map((entry: CollectionEntry<'dreams'>) => entry.data.category))];

  return allCategories.flatMap((category: string) => {
    const filtered = allDreams
      .filter((entry: CollectionEntry<'dreams'>) => entry.data.category === category)
      .sort(
        (a: CollectionEntry<'dreams'>, b: CollectionEntry<'dreams'>) =>
          b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
      );

    return paginate(filtered, {
      params: { category },
      pageSize: 20,
    });
  });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<'dreams'>>;
}

function capitalize(s: string) {
  return s.charAt(0).toUpperCase() + s.slice(1);
}

const { category } = Astro.params;
const { page } = Astro.props;
const totalCount = page.total;

const pageTitle =
  page.currentPage === 1
    ? `${capitalize(category)} Dream Meanings | Oneira Home`
    : `${capitalize(category)} Dream Meanings - Page ${page.currentPage} | Oneira Home`;

const pageDescription = `Explore ${totalCount} dream ${totalCount === 1 ? 'meaning' : 'meanings'} in the ${category} category - what these dreams tend to symbolize and what they might reflect about your waking life.`;

function getPageNumbers(current: number, last: number): (number | 'ellipsis')[] {
  const range = new Set<number>([1, last, current, current - 1, current + 1]);
  const sorted = [...range].filter((n) => n >= 1 && n <= last).sort((a, b) => a - b);

  const result: (number | 'ellipsis')[] = [];
  let prev = 0;
  for (const n of sorted) {
    if (n - prev > 1) result.push('ellipsis');
    result.push(n);
    prev = n;
  }
  return result;
}

const categoryCopy: Record<string, { h1: string; intro: string }> = {
  animals: {
    h1: 'Dream Animals: What Animal Dreams Mean',
    intro: 'Animals in dreams often stand for instincts, emotions, and parts of yourself you rarely name. This section gathers meanings for animals, from everyday pets like dogs and cats to wild creatures such as bears, wolves, and snakes.',
  },
  people: {
    h1: 'Dreams About People: Family, Exes and Strangers',
    intro: 'People in dreams often represent relationships, roles, or qualities you associate with them. Here you will find meanings for dreams about exes, strangers, babies, deceased parents, and other figures from waking life.',
  },
  places: {
    h1: 'Dream Places: Houses, Schools, Forests and More',
    intro: 'Places in dreams often reflect the parts of life they belong to: home, work, study, or the wider world. This section covers dreams about houses, schools, forests, bridges, and other locations.',
  },
  objects: {
    h1: 'Dream Objects: Keys, Doors, Mirrors and Everyday Items',
    intro: 'Objects in dreams often act as tools for a situation or a symbol of what you value. Find meanings for keys, doors, mirrors, money, clocks, and other everyday things that show up while you sleep.',
  },
  emotions: {
    h1: 'Emotions in Dreams: Crying, Laughter and Feelings',
    intro: 'Dreams often show feelings more clearly than events. This section covers dreams where emotional states, such as crying or laughing, are the central experience.',
  },
  body: {
    h1: 'Body Dreams: Teeth, Hair, Pregnancy and Blood',
    intro: 'Dreams about the body often reflect how you feel about your health, identity, or capacity to cope. This section covers common body-related dreams, from teeth falling out to pregnancy and giving birth.',
  },
  nature: {
    h1: 'Nature Dreams: Water, Fire, Storms and Natural Forces',
    intro: 'Natural elements in dreams often reflect emotion, change, and forces you cannot fully control. Explore meanings for water, fire, floods, storms, mountains, and other elements from the natural world.',
  },
  events: {
    h1: 'Event Dreams: Falling, Being Chased and Life Moments',
    intro: 'Dreams about events often mirror situations you are living through: a fall, a chase, an exam, a wedding, or a loss. This section covers the most common event scenarios and what they may suggest.',
  },
  other: {
    h1: 'Other Dreams: Monsters, Time Travel and Surreal Scenes',
    intro: 'Some dreams do not fit a simple category. This section covers unusual scenarios such as monsters, demons, time travel, and surreal experiences, and what they may reflect.',
  },
};

const copy = categoryCopy[category] ?? {
  h1: `${capitalize(category)} Dream Meanings`,
  intro: '',
};

const pageNumbers = getPageNumbers(page.currentPage, page.lastPage);
const basePath = Astro.url.pathname.replace(/\/\d+\/?$/, '').replace(/\/$/, '');

const listSchema = buildListSchema({
  name: pageTitle,
  description: pageDescription,
  url: Astro.url.href,
  site: Astro.site,
  entries: page.data,
});
---
<BaseLayout title={pageTitle} description={pageDescription} schema={listSchema}>
  <h1>
    {page.currentPage === 1 ? copy.h1 : `${copy.h1} — Page ${page.currentPage}`}
  </h1>
    {page.currentPage === 1 && copy.intro && (
      <p class="category-intro">{copy.intro}</p>
    )}
  <ul class="dream-list">
    {page.data.map((entry) => (
      <li>
        <a href={`/dream/${entry.slug}/`}>
        {entry.data.img && (
          <div class="dream-img">
            <img
              src={getThumbPath(entry.data.img)}
              alt={entry.data.title}
              width="480"
              height="255"
              loading="lazy"
            />
          </div>
        )}
        <h2>{entry.data.title}</h2>
        </a>
        <p class="dream-excerpt">{entry.data.description}</p>
      </li>
    ))}
  </ul>

  <nav class="pagination" aria-label="Pagination">
  {page.url.prev ? <a href={page.url.prev}>← Previous</a> : <span />}

  <div class="page-numbers">
    {pageNumbers.map((n) =>
      n === 'ellipsis' ? (
        <span class="ellipsis">…</span>
      ) : (
        <a
          href={n === 1 ? `${basePath}/` : `${basePath}/${n}/`}
          class={n === page.currentPage ? 'current' : ''}
          aria-current={n === page.currentPage ? 'page' : undefined}
        >
          {n}
        </a>
      )
    )}
  </div>

  {page.url.next ? <a href={page.url.next}>Next →</a> : <span />}
</nav>
</BaseLayout>

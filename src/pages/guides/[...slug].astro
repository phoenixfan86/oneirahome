---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListenButton from '../../components/ListenButton.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const guides = await getCollection(
    'guides',
    ({ data }: CollectionEntry<'guides'>) => !data.draft
  );
  return guides.map((entry: CollectionEntry<'guides'>) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<'guides'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const canonicalUrl = new URL(`/guides/${entry.slug}/`, Astro.site).href;
const publishedDate = entry.data.pubDate.toISOString();
const modifiedDate = (entry.data.updatedDate ?? entry.data.pubDate).toISOString();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: publishedDate,
  dateModified: modifiedDate,
  author: { '@type': 'Organization', name: 'Dream Dictionary' },
  publisher: { '@type': 'Organization', name: 'Dream Dictionary' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: canonicalUrl },
  ],
};

// у frontmatter, поруч із іншими schema-об'єктами:
const faqSchema = entry.data.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: entry.data.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
} : null;

const schemaList = faqSchema
  ? [articleSchema, breadcrumbSchema, faqSchema]
  : [articleSchema, breadcrumbSchema];
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.img}
  schema={schemaList}
>
  <article>
    <h1>{entry.data.h1 ?? entry.data.title}</h1>
    <ShareButtons url={canonicalUrl} title={entry.data.title} />
    {entry.data.img && (
      <div class="dream-img">
        <img
        src={entry.data.img}
        alt={entry.data.title}
        width="640"
        />
      </div>
    )}
    <ListenButton />
    <Content />
    {entry.data.faq.length > 0 && (
      <section class="faq-section">
        <h2>Frequently Asked Questions</h2>
        {entry.data.faq.map((item) => (
          <details class="faq-item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </section>
    )}
  </article>
</BaseLayout>

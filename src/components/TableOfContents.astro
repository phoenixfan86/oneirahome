---
interface Props {
  items: { depth: number; slug: string; text: string }[];
}
const { items } = Astro.props;
---

{items.length > 0 && (
  <nav class="toc" aria-label="Table of contents">
    <p class="toc-title">In this article</p>
    <ul>
      {items.map((item) => (
        <li class={`toc-depth-${item.depth}`}>
          <a href={`#${item.slug}`}>{item.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  function initToc() {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]')
    );
    if (links.length === 0) return;

    const headings = links
      .map((link) => document.getElementById(link.getAttribute('href')!.slice(1)))
      .filter((el): el is HTMLElement => el !== null);

    const linkByHeading = new Map<string, HTMLAnchorElement>();
    links.forEach((link) => {
      linkByHeading.set(link.getAttribute('href')!.slice(1), link);
    });

    const setActive = (id: string) => {
  links.forEach((l) => {
    l.classList.remove('active');
    l.removeAttribute('aria-current');
  });
  const current = linkByHeading.get(id);
  if (current) {
    current.classList.add('active');
    current.setAttribute('aria-current', 'location');
  }
};

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible.length > 0) {
          setActive(visible[0].target.id);
        }
      },
      {
        rootMargin: '-20% 0px -70% 0px',
        threshold: 0,
      }
    );

    headings.forEach((h) => observer.observe(h));
  }

  initToc();
</script>
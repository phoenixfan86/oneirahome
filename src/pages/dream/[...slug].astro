---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { getReadingTime } from '../../lib/readingTime';
import { detectMentions } from '../../lib/entities';
import RelatedDreams from '../../components/RelatedDreams.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import ListenButton from '../../components/ListenButton.astro';


export const getStaticPaths = (async () => {
  const dreams = await getCollection(
    'dreams',
    ({ data }: CollectionEntry<'dreams'>) => !data.draft
  );
  return dreams.map((entry: CollectionEntry<'dreams'>) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<'dreams'>;
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const tocItems = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({ depth: h.depth, slug: h.slug, text: h.text }));
const canonicalUrl = new URL(`/dream/${entry.slug}/`, Astro.site).href;
const publishedDate = entry.data.pubDate.toISOString();
const modifiedDate = (entry.data.updatedDate ?? entry.data.pubDate).toISOString();

const mentions = detectMentions(entry.body)

const sameCategory = (
  await getCollection(
    'dreams',
    ({ data }: CollectionEntry<'dreams'>) => !data.draft && data.category === entry.data.category
  )
).sort((a, b) => a.data.symbol.localeCompare(b.data.symbol));

const currentIndex = sameCategory.findIndex((d) => d.slug === entry.slug);
const prevDream = currentIndex > 0 ? sameCategory[currentIndex - 1] : null;
const nextDream = currentIndex < sameCategory.length - 1 ? sameCategory[currentIndex + 1] : null;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  image: entry.data.img,
  url: canonicalUrl,
  datePublished: publishedDate,
  dateModified: modifiedDate,
  author: { '@type': 'Organization', name: 'Oneira Home', url: 'https://www.oneirahome.com' },
  publisher: { '@type': 'Organization', name: 'Oneira Home' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  ...(mentions.length>0?{mentions}:{}),
};

const faqSchema = entry.data.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: entry.data.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;

const categoryName = entry.data.category
  ? entry.data.category.charAt(0).toUpperCase() + entry.data.category.slice(1)
  : 'Category';
 
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    {
      '@type': 'ListItem',
      position: 2,
      name: categoryName,
      item: new URL(`/categories/${entry.data.category}/`, Astro.site).href,
    },
    { '@type': 'ListItem', 
    position: 3, 
    name: entry.data.title || 'Dream Meaning', 
    item: canonicalUrl },
  ],
};

const readingTime = getReadingTime(entry.body)
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const publishedLabel = dateFormatter.format(entry.data.pubDate);

const hasRealUpdate =
  entry.data.updatedDate !== undefined &&
  entry.data.updatedDate.getTime() > entry.data.pubDate.getTime();

const updatedLabel = hasRealUpdate
  ? dateFormatter.format(entry.data.updatedDate!)
  : null;
---
<BaseLayout 
title={entry.data.title} 
description={entry.data.description} 
image={entry.data.img}
tocItems={tocItems}
schema={faqSchema ? [articleSchema, breadcrumbSchema, faqSchema] : [articleSchema, breadcrumbSchema]}
>
  <article class="dream-body">
    <nav aria-label="Breadcrumb">
      <ul class="breadcrumb">
        <li><a href="/">Home</a></li>
        <li><a href={`/categories/${entry.data.category}/`}>{categoryName}</a></li>
        <li aria-current="page">{entry.data.title}</li>
      </ul>
    </nav>
    <span class="read-time">{readingTime}</span>
    
    <h1 class="dream-title">{entry.data.h1 ?? entry.data.title}</h1>
    <div class="more-opt">
      <ShareButtons url={canonicalUrl} title={entry.data.title} />
      <p class="article-dates">
        <time datetime={publishedDate}>Published {publishedLabel}</time>
        {updatedLabel && (
          <>
            {' · '}
            <time datetime={entry.data.updatedDate!.toISOString()}>Updated {updatedLabel}</time>
          </>
        )}
      </p>
    </div>
    
    <p class="dream-meta">
      Category: <a href={`/categories/${entry.data.category}`}>{entry.data.category}</a>
      {entry.data.tags.length > 0 && (
        <span>
          {' · '}
          <span>dream themes</span>
          {entry.data.tags.map((tag: string, i: number) => (
            <>
              <a href={`/tags/${tag}/`}>{tag}</a>{i < entry.data.tags.length - 1 ? ', ' : ''}
            </>
          ))}
        </span>
      )}
    </p>
    {entry.data.img && (
      <div class="dream-img">
        <img
        src={entry.data.img}
        alt={entry.data.title}
        width="640"
        />
      </div>
    )}
    <ListenButton />
    <br>
    <Content />
    {entry.data.faq.length > 0 && (
      <section class="faq-section">
        <h2>Frequently Asked Questions</h2>
        {entry.data.faq.map((item) => (
          <details class="faq-item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </section>
    )}
    
    <RelatedDreams category={entry.data.category} excludeSlug={entry.slug} />
    {(prevDream || nextDream) && (
  <nav class="dream-pager" aria-label="Category navigation">
    {prevDream ? (
      <a href={`/dream/${prevDream.slug}/`}>← Prev {prevDream.data.symbol}</a>
    ) : <span />}
    {nextDream ? (
      <a href={`/dream/${nextDream.slug}/`}>Next {nextDream.data.symbol} →</a>
    ) : <span />}
  </nav>
)}
  </article>
</BaseLayout>

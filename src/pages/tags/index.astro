---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const allDreams = await getCollection(
  'dreams',
  ({ data }: CollectionEntry<'dreams'>) => !data.draft
);

const allTags = Array.from(
  new Set(allDreams.flatMap((entry: CollectionEntry<'dreams'>) => entry.data.tags))
).sort((a: string, b: string) => a.localeCompare(b));
const pageTitle = `${allTags.length} Dream Themes & Symbols | Oneira Home`;
const pageDescription = `Every theme covered in the dictionary so far, from fear and transformation to relationships and change - pick a theme to see related dream meanings.`;
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <h1>All Tags</h1>
  <p>Browse dream meanings grouped by theme.</p>

  <ul class="tag-grid">
    {allTags.map((tag: string) => (
      <li>
        <a href={`/tags/${tag}/`}>{tag}</a>
      </li>
    ))}
  </ul>
</BaseLayout>

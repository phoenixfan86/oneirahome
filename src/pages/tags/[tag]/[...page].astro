---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';

export const getStaticPaths = (async ({ paginate }) => {
  const allDreams = await getCollection(
    'dreams',
    ({ data }: CollectionEntry<'dreams'>) => !data.draft
  );

  const allTags = [...new Set(allDreams.flatMap((entry: CollectionEntry<'dreams'>) => entry.data.tags))];

  return allTags.flatMap((tag: string) => {
    const filtered = allDreams
      .filter((entry: CollectionEntry<'dreams'>) => entry.data.tags.includes(tag))
      .sort(
        (a: CollectionEntry<'dreams'>, b: CollectionEntry<'dreams'>) =>
          b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
      );

    return paginate(filtered, {
      params: { tag },
      pageSize: 20,
    });
  });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<'dreams'>>;
}

const { tag } = Astro.params;
const { page } = Astro.props;
const pageTitle = page.currentPage === 1 ? `Dreams About ${tag}` : `Dreams About ${tag} — Page ${page.currentPage}`;

function getPageNumbers(current: number, last: number): (number | 'ellipsis')[] {
  const range = new Set<number>([1, last, current, current - 1, current + 1]);
  const sorted = [...range].filter((n) => n >= 1 && n <= last).sort((a, b) => a - b);

  const result: (number | 'ellipsis')[] = [];
  let prev = 0;
  for (const n of sorted) {
    if (n - prev > 1) result.push('ellipsis');
    result.push(n);
    prev = n;
  }
  return result;
}

const pageNumbers = getPageNumbers(page.currentPage, page.lastPage);
---
<BaseLayout title={pageTitle} description={`All dream meanings tagged "${tag}".`}>
  <h1>Dreams tagged: {tag}</h1>

  <ul class="dream-list">
    {page.data.map((entry) => (
      <li class="dream-item">
        <a href={`/dream/${entry.slug}/`}><strong>{entry.data.title}</strong></a>
        <p class="dream-excerpt">{entry.data.description}</p>
      </li>
    ))}
  </ul>

  <nav class="pagination" aria-label="Pagination">
  {page.url.prev ? <a href={page.url.prev} aria-label="Previous page">← Previous</a> : <span />}

  <div class="page-numbers">
    {pageNumbers.map((n) =>
      n === 'ellipsis' ? (
        <span class="ellipsis">…</span>
      ) : (
        
          <a href={n === 1 ? '/tags/' : `/tags/${n}/`}
          class={n === page.currentPage ? 'current' : ''}
          aria-current={n === page.currentPage ? 'page' : undefined}
        >
          {n}
        </a>
      )
    )}
  </div>

  {page.url.next ? <a href={page.url.next} aria-label="Next page">Next →</a> : <span />}
</nav>

  <p><a href="/tags/">← All tags</a></p>
</BaseLayout>
